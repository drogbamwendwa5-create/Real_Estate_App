# Backend Environment Variables
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:19006

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password
EMAIL_FROM=your_email@gmail.com

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:19006

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Frontend Environment Variables (Expo)
EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_MAPS_API_KEY=your_google_maps_api_key
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# ============================================
# Property Aggregation Engine Configuration
# ============================================

# Cache Configuration
CACHE_ENABLED=true

# Queue Processing (BullMQ with Redis)
QUEUE_ENABLED=false
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Parallel Scraping
PARALLEL_SCRAPING_ENABLED=true

# Proxy Configuration
PROXY_PROVIDER=          # brightdata, scraperapi, zenrows, scrapingbee, oxylabs, webshare, custom
PROXY_URL=               # e.g., http://username:password@proxy:port
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_LIST=              # comma-separated list of proxy URLs for rotation

# AI Enrichment
AI_ENRICHMENT_ENABLED=false
AI_API_KEY=
AI_API_URL=

# Location Service
LOCATION_SERVICE_ENABLED=true
GEOCODING_API_KEY=A8P3899oy70Oqvapprt0X7RUtSwYhAk5ovXNCgWrtKctEpNrAkACYICB5Zhnc59w

# Scheduler
RUN_ON_STARTUP=false

# Scraper Source Control (enable/disable individual sources)
# Set to 'true' or 'false' to control individual scrapers
# Listing Websites
SOURCE_BUYRENT_ENABLED=true
SOURCE_PROPERTY24_ENABLED=true
SOURCE_KENYAPROPERTYCENTRE_ENABLED=true
SOURCE_HAUZISHA_ENABLED=true
SOURCE_JIJI_ENABLED=true
SOURCE_PIGIAME_ENABLED=true
SOURCE_RENTKENYA_ENABLED=true

# Commercial Listings
SOURCE_OFFICESPACE_ENABLED=true
SOURCE_COMMERCIALKE_ENABLED=true

# Short-term Rentals
SOURCE_AIRBNB_ENABLED=true
SOURCE_BOOKING_ENABLED=true
SOURCE_VRBO_ENABLED=true

# Developer Websites
SOURCE_DEVELOPERS_ENABLED=true
SOURCE_MIVIDA_ENABLED=true
SOURCE_SUPERIORHOMES_ENABLED=true
SOURCE_CENTUM_ENABLED=true
SOURCE_FUSIONCAPITAL_ENABLED=true
SOURCE_ACORNHOLDINGS_ENABLED=true
SOURCE_KINGSDEVELOPERS_ENABLED=true
SOURCE_WILLSTONEHOMES_ENABLED=true
SOURCE_MAHIGAHOMES_ENABLED=true
SOURCE_KINGSPRIDE_ENABLED=true
SOURCE_HASSCONSULT_ENABLED=true
SOURCE_FANAKA_ENABLED=true
SOURCE_HOMEAFRIKA_ENABLED=true
SOURCE_ERDEMANN_ENABLED=true
SOURCE_SIC_ENABLED=true
SOURCE_KARIBUHOMES_ENABLED=true
SOURCE_MUGADEVELOPERS_ENABLED=true
SOURCE_WESTON_ENABLED=true
SOURCE_MVULEGARDENS_ENABLED=true
SOURCE_JABAVU_ENABLED=true

# Real Estate Agencies
SOURCE_KNIGHTFRANK_ENABLED=true
SOURCE_PAMGOLDING_ENABLED=true

# Web Search
SOURCE_WEBSEARCH_ENABLED=true

# ============================================
# OpenStreetMap Geospatial Configuration
# ============================================

# OSM Tile Server (map rendering)
OPENSTREETMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Nominatim Geocoding Service
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Overpass API (amenities / POI queries)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# OSRM Routing Engine
OSRM_URL=https://router.project-osrm.org

# Photon Geocoding (fast autocomplete)
PHOTON_URL=https://photon.komoot.io
